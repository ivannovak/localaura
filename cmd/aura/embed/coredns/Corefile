# CoreDNS configuration for .aura TLD
# Wildcard resolves all *.aura domains to 127.0.0.2

aura:53 {
    # Log DNS queries for debugging
    log

    # Respond to all .aura domains with 127.0.0.2
    template IN A aura {
        answer "{{ .Name }} 0 IN A 127.0.0.2"
        rcode NOERROR
    }

    # Also handle AAAA (IPv6) queries with NODATA response
    template IN AAAA aura {
        rcode NOERROR
    }

    # Enable errors logging
    errors

    # NOTE: Rate limiting not implemented
    # Rationale: DNS server bound to localhost (127.0.0.2) only, accessible
    # only from local machine. Risk of DNS query abuse is minimal in this
    # context. CoreDNS ratelimit plugin would require external plugin setup.
    # If needed in future, consider:
    #   - ratelimit plugin (requires CoreDNS rebuild with plugin)
    #   - iptables/pf firewall rules at OS level
    #   - Docker container resource limits
}

# SECURITY NOTE: Fallback DNS resolution
# This block forwards non-.aura queries to the system resolver.
# If the CoreDNS container is compromised, this could enable:
#   - DNS tunneling for data exfiltration
#   - DNS query logging/tracking
#   - Malicious query injection
#
# Mitigation: System resolver configuration (/etc/resolver/aura on macOS,
# systemd-resolved on Linux) already restricts CoreDNS to only handle
# .aura domains, so this fallback is rarely used in practice.
#
# For maximum security, consider removing this block entirely.
# See docs/ADVANCED.md for details.
. {
    forward . /etc/resolv.conf
    log
    errors
}
